<% layout("/layouts/boilerplate"); %>
<div class="row mt-3">
    <div class="col-8 offset-2">

        <h2><%= allList?.title %></h2> 
        <div class="card border-0 mb-3">
            <% if (allList?.image?.url) { %>
                <img src="<%= allList.image.url %>" class="card-img-top show-img" alt="Listing Image">
            <% } %>
            <div class="card-body">
                <p class="card-text">
        <%= allList.owner[0].username %> <br>
    <%= allList?.description %> <br>
                    &#8377; <%= allList?.price.toLocaleString("en-IN") %> <br>
                    <%= allList?.location %> <br>
                    <%= allList?.country %>
                </p>
            </div>    
        </div>
        <div class="d-flex mb-3">
            <form method="get" action="/listings/<%=allList._id%>/edit">
                <button class="btn btn-dark me-3">Edit</button>
            </form>
            <form method="post" action="/listings/<%=allList._id%>/delete">
                <button class="btn btn-dark">Delete</button>
            </form>
        </div>
        <hr>
        <% if(currUser) { %>
        <div class="mb-3 mt-3">
            <h4>Leave a Review</h4>
            <form action="/listings/<%=allList._id%>/reviews" method="post" class="needs-validation" novalidate>
                <div class="mb-3 mt-3">
                <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" class="form-control" cols="30" rows="5" required></textarea>
                    <div class="invalid-feedback">Please add some comments for your review.</div>
                </div>
                <button type="submit" class="btn btn-outline-dark">Submit</button>
            </form>
        </div>
                <hr>

        <% } %>


        <% if(allList.reviews.length > 0) { %>
            <h4>All Reviews</h4>
            <div class="row">
                <% for(review of allList.reviews) { %>
                    <div class="col-6 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                             <h5 class="card-title">@<%=review.author.username%></h5>
                                    <p class="starability-result card-title" data-rating="<%=review.rating%>"</p>
                                <p class="card-text"><%= review.comment %></p>
                                <form class="mb-3" method="POST" action="/listings/<%= allList._id %>/reviews/<%= review._id %>/delete?_method=DELETE">
                                    <button class="btn btn-sm btn-dark" type="submit">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
            <div class="mb-3 mt-3">
                        <h3>Where You'll be :</h3>
              <div id="map"></div>
              <p id="map-error" class="text-danger mt-2" role="alert" hidden></p>
              
    </div>

</div>

<% const coordinates = allList.geometry?.coordinates ?? null; %>
<script>
  window.mapData = {
    token: <%- JSON.stringify(process.env.MAP_TOKEN || null) %>,
    coordinates: <%- JSON.stringify(coordinates) %>,
    title: <%- JSON.stringify(allList.title) %>,
    error: <%- JSON.stringify(mapError || null) %>
  };
</script>

<script src="/js/map.js"></script>
