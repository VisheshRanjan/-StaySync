
<%if(locals.success && success.length>0){%>
<div class="alert alert-success alert-dismissible fade show col-6 offset-3" role="alert"><%= success %></div>
<%} else if(locals.error && error.length>0) {%>
    <div class="alert alert-danger alert-dismissible fade show col-6 offset-3" role="alert"><%= error %></div>
<% } %>
